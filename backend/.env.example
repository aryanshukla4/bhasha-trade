APP_ENV=development
DATABASE_URL=postgresql+psycopg://bhasha_trade:change_me@localhost:5432/bhasha_trade
JWT_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=http://localhost:3000

# Chat assistant (optional - falls back to a static tip if unset)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
AGMARKNET_API_KEY=
OPENWEATHER_API_KEY=

# Crop disease detection (optional - endpoint returns 503 if unset/missing)
KINDWISE_API_KEY=
CROP_MODEL_ROOT=./crop_model
CROP_CONFIDENCE_THRESHOLD=0.55
