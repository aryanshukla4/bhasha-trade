
PORT=4000
JWT_SECRET=replace-this-with-a-long-random-secret
DATABASE_PATH=./data/bhasha-trade.sqlite
OTP_TTL_MINUTES=10
# Configure an SMS vendor here in production. Until then OTP is returned only in development.
NODE_ENV=development



# Copy this file to .env and fill in your real key
# Get a free Groq API key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Which model to use (free options on Groq as of 2026)
GROQ_MODEL=llama-3.1-8b-instant
